# Google OAuth2 (optional — not used in this project; application.yml defaults to dummy)
# GOOGLE_CLIENT_ID=dummy
# GOOGLE_CLIENT_SECRET=dummy

# Kakao OAuth2 — add the same values as repository secrets KAKAO_CLIENT_ID and
# KAKAO_CLIENT_SECRET for GitHub Actions CI.
KAKAO_CLIENT_ID=your_kakao_rest_api_key_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here   # 없으면 빈 값

# JWT Secret (256비트 이상의 임의 문자열)
JWT_SECRET=your_super_secret_jwt_key_here_must_be_at_least_256_bits_long

# Public API base URL for Swagger UI (HTTPS). Set on production behind a reverse proxy.
# Example: API_PUBLIC_URL=https://thinkmap-api.shop
# API_PUBLIC_URL=

# Gemini API (required for AI features; maps to gemini.* in application.yml)
# Also add the same value as repository secret GEMINI_API_KEY for GitHub Actions CI.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash

# MySQL / RDS — only if you switch application.yml from H2 to MySQL.
# Default stack uses H2 in-memory; leave these commented out.
# LOCAL_DB_URL=jdbc:mysql://localhost:3306/thinkmap_db?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
# LOCAL_DB_USERNAME=root
# LOCAL_DB_PASSWORD=your_password
